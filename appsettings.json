{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {

    "Routes": {
      "auth-route": {
        "ClusterId": "cluster-security",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "tenants-route": {
        "ClusterId": "cluster-security",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/tenants/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "cluster-security",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "reference-activity-route": {
        "ClusterId": "cluster-reference",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/activities/{**catch-all}" }
      },
      "reference-afip-company-type-route": {
        "ClusterId": "cluster-reference",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/afip-company-types/{**catch-all}" }
      },
      "reference-provincia-route": {
        "ClusterId": "cluster-reference",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/provinces/{**catch-all}" }
      },
      "reference-all-route": {
        "ClusterId": "cluster-reference",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/reference/{**catch-all}" }
      }
    },
    "Clusters": {
      "cluster-security": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "primary": { "Address": "http://zenthia-security_zenthia-security:8080/" }
        }
      },
      "cluster-reference": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "primary": { "Address": "http://zenthia-reference_zenthia-reference:8081/" }
        }
      }
    }
  }
}
